{
  "experiment_name": "klue_roberta_base_multitask_t4",
  "model_name": "klue/roberta-base",
  "input_field": "facts",
  "target_fields": [
    "fine_lv",
    "imprisonment_with_labor_lv",
    "imprisonment_without_labor_lv"
  ],
  "excluded_input_fields": [
    "reason",
    "ruling",
    "casename",
    "label_text"
  ],
  "max_length": 512,
  "train_batch_size": 8,
  "eval_batch_size": 16,
  "gradient_accumulation_steps": 2,
  "learning_rate": 2e-05,
  "weight_decay": 0.01,
  "epochs": 3,
  "warmup_ratio": 0.1,
  "dropout": 0.1,
  "max_grad_norm": 1.0,
  "class_weight_method": "sqrt_inverse_frequency",
  "fp16": true,
  "gradient_checkpointing": true,
  "seed": 42
}
